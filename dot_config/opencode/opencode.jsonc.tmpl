// https://opencode.ai/docs/config/
{
  "$schema": "https://opencode.ai/config.json",
  // though .env and .gitignore are considered
  // (https://github.com/anomalyco/opencode/commit/4c2e888709fde5aa870d426cf272c6d00495d5b5)
  // (https://github.com/anomalyco/opencode/issues/4969)
  // disallow everything by default, select agent for specific permissions
  // V2: one ordered "permissions" array (was "permission" per tool), last match wins
  "permissions": [
    // read: order matters (!)
    // outside of project
    { "action": "read", "resource": "~", "effect": "deny" },
    { "action": "read", "resource": "/*", "effect": "deny" }, // this seems to catch all
    // inside the project
    { "action": "read", "resource": "*", "effect": "allow" },
    // secrets
    { "action": "read", "resource": "*.env*", "effect": "deny" },
    { "action": "read", "resource": "*secret*", "effect": "deny" },
    { "action": "read", "resource": "*token*", "effect": "deny" },
    { "action": "read", "resource": "*password*", "effect": "deny" },
    { "action": "read", "resource": "secrets/**", "effect": "deny" },
    { "action": "read", "resource": "credentials/**", "effect": "deny" },
    // certificates and keys
    { "action": "read", "resource": "id*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.crt", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.keystore", "effect": "deny" },
    { "action": "read", "resource": "*.jks", "effect": "deny" },
    // other
    { "action": "read", "resource": ".git", "effect": "deny" },
    // V1 asked before touching paths outside the project, V2 allows it by default
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    // shell (was "bash" in V1)
    // be careful as the agent can request for any command (!)
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "rtk *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "rm", "effect": "deny" },
    // git
    { "action": "shell", "resource": "git status", "effect": "allow" },
    { "action": "shell", "resource": "git diff", "effect": "allow" },
    { "action": "shell", "resource": "git merge", "effect": "deny" },
    { "action": "shell", "resource": "git revert", "effect": "deny" },
    { "action": "shell", "resource": "git reset", "effect": "deny" },
    { "action": "shell", "resource": "git rebase", "effect": "deny" },
    // python stuff
    { "action": "shell", "resource": "uv run pytest", "effect": "allow" },
    { "action": "shell", "resource": "uv tool *", "effect": "deny" },
    // in case i want to use openspec sometime :)
    { "action": "shell", "resource": "openspec archive --yes --skip-specs", "effect": "deny" },
  ],
  // default model: OpenCode Go - MiniMax M3
  "model": "opencode-go/minimax-m3",
  "agents": {
    // do not allow scanning at all
    // see watcher, however this is experimental
    // use a lightweight cloud model for title generation to avoid the local model
    // being called simultaneously for two sessions (causes stalling, issue #33126)
    // V1: "small_model"
    "title": { "model": "opencode/deepseek-v4-flash-free" },
  },
  "instructions": [
    // typically available in the projects
    "README.md",
    "CONTRIBUTING.md",
    // "AGENTS.md", // automatically loaded by agents in projects
  ],
{{- if .hasLocalLLM }}
  // MCP servers
  "mcp": {
    "servers": {
      "browsermcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@browsermcp/mcp@latest"
        ],
        "disabled": false
      }
    }
  },
  // other providers and local models
  "providers": {
    "llama.cpp": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "settings": {
        "baseURL": "http://127.0.0.1:12345/v1"
      },
      "models": {
        "qwen3-8b": {
          "name": "Qwen3 8B",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "devstral-small-2-2512": {
          "name": "Devstral Small 2 24B Instruct 2512",
          "capabilities": {
            "tools": true
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
      }
    },
  },
{{- end }}
}
