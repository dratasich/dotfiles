{{- /* per-machine data; prompted once, stored in ~/.config/chezmoi/chezmoi.toml */ -}}
{{- /* defaults may be overridden */ -}}
{{- $email := promptStringOnce . "email" "Git email" "dratasich@users.noreply.github.com" -}}
{{- $name := promptStringOnce . "name" "Git name" "Denise Ratasich" -}}
{{- $hasLocalLLM := promptBoolOnce . "hasLocalLLM" "Local LLM via llama.cpp available" true -}}
{{- $useKeePassXC := promptBoolOnce . "useKeePassXC" "Secrets from KeePassXC (kdbx via Syncthing)" true -}}

{{- /* keep sourceDir pointing at the repo when it is a working clone (not a chezmoi-managed copy) */ -}}
{{- $sourceDir := .chezmoi.sourceDir -}}
{{- if ne $sourceDir (joinPath .chezmoi.homeDir ".local" "share" "chezmoi") }}
sourceDir = {{ $sourceDir | quote }}
{{ end -}}

{{- if $useKeePassXC }}
# keepassxc integration (keepassxc-cli): secrets live in the Syncthing'd kdbx
[keepassxc]
    database = {{ joinPath .chezmoi.homeDir "Sync" "configs" "keepassx" "private.kdbx" | quote }}
{{ end }}

[data]
    email = {{ $email | quote }}
    name = {{ $name | quote }}
    hasLocalLLM = {{ $hasLocalLLM }}
    useKeePassXC = {{ $useKeePassXC }}
